#!/bin/bash

# BIDR Auth Service SSL Deployment Script
# This script builds and deploys only the auth service with SSL

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
RESOURCE_GROUP="bidr-simple-rg"
LOCATION="westus"
ACR_NAME="bidrcontainers"
CERT_DIR="/tmp/bidr-ssl-certs"
DEPLOYMENT_DIR="./ssl-deployments"

# Service configuration: name:external_port:internal_port:directory
SERVICE_NAME="auth"
EXTERNAL_PORT="443"
INTERNAL_PORT="8000"
SERVICE_DIR="authentication_service"

print_header() {
    echo -e "${BLUE}============================================${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}============================================${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

# Check prerequisites
check_prerequisites() {
    print_header "Checking Prerequisites"
    
    # Check Azure CLI
    if ! command -v az &> /dev/null; then
        print_error "Azure CLI is not installed"
        exit 1
    fi
    print_success "Azure CLI is installed"
    
    # Check Docker
    if ! command -v docker &> /dev/null; then
        print_error "Docker is not installed"
        exit 1
    fi
    print_success "Docker is installed"
    
    # Check if logged into Azure
    if ! az account show &> /dev/null; then
        print_error "Not logged into Azure CLI. Run 'az login' first"
        exit 1
    fi
    print_success "Logged into Azure CLI"
    
    # Check if certificates exist
    if [ ! -d "$CERT_DIR" ]; then
        print_error "SSL certificates not found. Run generate-ssl-certs.sh first"
        exit 1
    fi
    print_success "SSL certificates found"
}

# Setup deployment directory
setup_deployment_dir() {
    print_header "Setting up Deployment Directory"
    
    if [ -d "$DEPLOYMENT_DIR/$SERVICE_NAME" ]; then
        print_warning "Auth deployment directory exists, cleaning up..."
        rm -rf "$DEPLOYMENT_DIR/$SERVICE_NAME"
    fi
    
    mkdir -p "$DEPLOYMENT_DIR/$SERVICE_NAME"
    print_success "Deployment directory created: $DEPLOYMENT_DIR/$SERVICE_NAME"
}

# Generate service configuration
generate_service_config() {
    print_header "Generating Auth Service Configuration"
    
    local domain="bidr-auth-api.westus.azurecontainer.io"
    local deploy_service_dir="$DEPLOYMENT_DIR/$SERVICE_NAME"
    
    # Generate nginx config
    local nginx_config="$deploy_service_dir/nginx-$SERVICE_NAME.conf"
    sed -e "s/{{SERVICE_NAME}}/$SERVICE_NAME/g" \
        -e "s/{{DOMAIN}}/$domain/g" \
        -e "s/{{BACKEND_PORT}}/$INTERNAL_PORT/g" \
        ssl-setup/nginx-ssl.conf.template > "$nginx_config"
    
    # Generate Dockerfile
    local dockerfile="$deploy_service_dir/Dockerfile"
    sed -e "s/{{SERVICE_NAME}}/$SERVICE_NAME/g" \
        -e "s/{{BACKEND_PORT}}/$INTERNAL_PORT/g" \
        ssl-setup/Dockerfile.ssl.template > "$dockerfile"
    
    # Copy SSL certificates
    local cert_source_dir="$CERT_DIR/$domain"
    local cert_dest_dir="$deploy_service_dir/ssl-certs/$SERVICE_NAME"
    local key_dest_dir="$deploy_service_dir/ssl-keys/$SERVICE_NAME"
    
    mkdir -p "$cert_dest_dir" "$key_dest_dir"
    cp "$cert_source_dir/fullchain.pem" "$cert_dest_dir/"
    cp "$cert_source_dir/privkey.pem" "$key_dest_dir/"
    
    # Copy service source code
    if [ -d "$SERVICE_DIR" ]; then
        cp -r "$SERVICE_DIR" "$deploy_service_dir/$SERVICE_NAME"
    else
        print_error "Service directory $SERVICE_DIR not found"
        exit 1
    fi
    
    print_success "Configuration generated for $SERVICE_NAME"
}

# Build and push Docker image
build_and_push_image() {
    print_header "Building and Pushing Auth SSL Image"
    
    # Login to ACR
    az acr login --name $ACR_NAME
    
    local deploy_service_dir="$DEPLOYMENT_DIR/$SERVICE_NAME"
    local image_name="$ACR_NAME.azurecr.io/bidr-$SERVICE_NAME-ssl:latest"
    
    echo -e "${BLUE}Building image for: $SERVICE_NAME${NC}"
    
    # Build image for AMD64 platform (Azure Container Instances requirement)
    docker build --platform linux/amd64 -t "$image_name" "$deploy_service_dir"
    
    # Push image
    docker push "$image_name"
    
    print_success "Image built and pushed: $image_name"
}

# Deploy container to Azure
deploy_container() {
    print_header "Deploying Auth SSL Container"
    
    local image_name="$ACR_NAME.azurecr.io/bidr-$SERVICE_NAME-ssl:latest"
    local container_name="bidr-$SERVICE_NAME-ssl-container"
    
    echo -e "${BLUE}Deploying container: $container_name${NC}"
    
    # Get ACR credentials
    local acr_username=$(az acr credential show --name $ACR_NAME --query username --output tsv)
    local acr_password=$(az acr credential show --name $ACR_NAME --query passwords[0].value --output tsv)
    
    # Deploy container
    az container create \
        --resource-group "$RESOURCE_GROUP" \
        --name "$container_name" \
        --image "$image_name" \
        --os-type Linux \
        --registry-login-server "$ACR_NAME.azurecr.io" \
        --registry-username "$acr_username" \
        --registry-password "$acr_password" \
        --dns-name-label "bidr-auth-api" \
        --ports 443 80 \
        --cpu 1 \
        --memory 2 \
        --location "$LOCATION" \
        --environment-variables \
            DJANGO_SETTINGS_MODULE="authentication_service.settings" \
            DEBUG="False" \
            ALLOWED_HOSTS="*" \
            SECURE_SSL_REDIRECT="False" \
        --restart-policy Always
    
    if [ $? -eq 0 ]; then
        print_success "Container deployed: $container_name"
        
        # Get container details
        sleep 10  # Wait for container to initialize
        local container_info=$(az container show --resource-group "$RESOURCE_GROUP" --name "$container_name" --query '{fqdn: ipAddress.fqdn, ip: ipAddress.ip, state: containers[0].instanceView.currentState.state}' --output json)
        local fqdn=$(echo "$container_info" | jq -r '.fqdn')
        local ip=$(echo "$container_info" | jq -r '.ip')
        local state=$(echo "$container_info" | jq -r '.state')
        
        echo ""
        echo -e "${GREEN}🚀 Auth Service SSL Deployment Complete!${NC}"
        echo "  Container Name: $container_name"
        echo "  FQDN: $fqdn"
        echo "  IP: $ip"
        echo "  State: $state"
        echo "  HTTPS URL: https://$fqdn/"
        echo "  Admin URL: https://$fqdn/admin/"
        echo ""
    else
        print_error "Failed to deploy container: $container_name"
        exit 1
    fi
}

# Test HTTPS endpoint
test_https_endpoint() {
    print_header "Testing HTTPS Endpoint"
    
    local container_name=$(az container list --resource-group "$RESOURCE_GROUP" --query "[?contains(name, 'bidr-auth-ssl')].name" --output tsv | head -1)
    
    if [ -n "$container_name" ]; then
        local fqdn=$(az container show --resource-group "$RESOURCE_GROUP" --name "$container_name" --query 'ipAddress.fqdn' --output tsv 2>/dev/null || echo "")
        
        if [ -n "$fqdn" ] && [ "$fqdn" != "null" ]; then
            echo -e "${BLUE}Testing: $SERVICE_NAME ($fqdn)${NC}"
            
            # Test HTTPS endpoint
            if curl -k -s --connect-timeout 10 "https://$fqdn/health/" > /dev/null 2>&1; then
                print_success "HTTPS endpoint is accessible: https://$fqdn/health/"
            else
                print_warning "HTTPS endpoint not responding yet (container may still be starting): https://$fqdn/health/"
            fi
            
            # Test certificate
            echo "Testing SSL certificate..."
            local cert_info=$(echo | openssl s_client -connect "$fqdn:443" -servername "$fqdn" 2>/dev/null | openssl x509 -noout -subject -dates 2>/dev/null || echo "Certificate check failed")
            if [ -n "$cert_info" ] && [ "$cert_info" != "Certificate check failed" ]; then
                echo "  Certificate info: $cert_info"
            else
                print_warning "SSL certificate check failed (container may still be starting)"
            fi
        fi
    fi
}

# Main execution
main() {
    print_header "BIDR Auth Service SSL Deployment"
    
    # Check prerequisites
    check_prerequisites
    
    # Setup deployment directory
    setup_deployment_dir
    
    # Generate service configuration
    generate_service_config
    
    # Build and push image
    build_and_push_image
    
    # Deploy container
    deploy_container
    
    # Test endpoint
    test_https_endpoint
    
    print_header "Deployment Complete!"
    echo -e "${GREEN}Auth service with SSL has been successfully deployed!${NC}"
}

# Run main function
main "$@"
