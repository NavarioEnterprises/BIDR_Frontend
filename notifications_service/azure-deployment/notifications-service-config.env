# BIDR Notifications Service - Azure Container Instances Deployment Configuration

# Azure Resource Configuration
RESOURCE_GROUP="bidr-simple-rg"
CONTAINER_REGISTRY="bidrsimpleregistry"
CONTAINER_NAME="bidr-notifications-service"
IMAGE_NAME="bidr-notifications-service"
SERVICE_PORT="8000"
LOCATION="westus"

# Application Gateway Configuration
APP_GATEWAY_NAME="bidr-app-gateway"
BACKEND_POOL_NAME="notifications-backend-pool"

# Domain and SSL Configuration
DOMAIN_NAME="notifications.bidr.co.za"
PRODUCTION_URL="https://notifications.bidr.co.za/"

# Container Environment Variables
SECRET_KEY="your-notifications-service-secret-key-here"
DEBUG="False"
ALLOWED_HOSTS="*"
DJANGO_SETTINGS_MODULE="notifications.settings"
CORS_ALLOW_ALL_ORIGINS="True"

# SMS Configuration (Optional - add your actual SMS provider settings)
SMS_PROVIDER="twilio"
SMS_API_KEY=""
SMS_API_SECRET=""

# Email Configuration (Optional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS="True"

# Container Resources
CPU_CORES="1.0"
MEMORY_GB="1.5"

# Security and Networking
RESTART_POLICY="OnFailure"
DNS_LABEL="bidr-notifications-service"

# Service Information
SERVICE_NAME_DISPLAY="BIDR Notifications Service"
BIDR_VERSION="v$(date +%s)"
DEPLOYMENT_TIMESTAMP="$(date)"
