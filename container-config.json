{
  "location": "westus",
  "properties": {
    "containers": [
      {
        "name": "bidr-auth-service",
        "properties": {
          "image": "bidrsimpleregistry.azurecr.io/bidr-authentication-service:latest",
          "ports": [
            {
              "port": 8000,
              "protocol": "TCP"
            }
          ],
          "environmentVariables": [
            {
              "name": "SECRET_KEY",
              "value": "RZU1QPUcQfUxElNc8yKxVPFH4bCoJ2z3Fe0o2JlhhbI="
            },
            {
              "name": "DEBUG",
              "value": "False"
            },
            {
              "name": "ALLOWED_HOSTS",
              "value": "*"
            },
            {
              "name": "DJANGO_SETTINGS_MODULE",
