              "cpu": 1.0,
              "memoryInGb": 1.5
            }
          }
        }
      }
    ],
    "imageRegistryCredentials": [
      {
        "server": "bidrsimpleregistry.azurecr.io",
        "username": "bidrsimpleregistry"
      }
    ],
    "ipAddress": {
      "type": "Public",
      "dnsNameLabel": "bidr-auth-1756991300",
      "ports": [
        {
