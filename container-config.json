            },
            {
              "name": "JWT_SECRET_KEY",
              "value": "gJ8nmLP9pYQWkxjqZIwObz8+UaGZ4IZQvxhG/bV6n3s="
            },
            {
              "name": "CORS_ALLOW_ALL_ORIGINS",
