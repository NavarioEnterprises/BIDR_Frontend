# BIDR Authentication Service - Azure Deployment Configuration
# This file contains all the configuration variables for the auth service deployment

# Azure Configuration
RESOURCE_GROUP=bidr-simple-rg
CONTAINER_REGISTRY=bidrsimpleregistry
CONTAINER_NAME=bidr-auth-service
IMAGE_NAME=bidr-auth-service
SERVICE_PORT=8000
LOCATION=westus

# Application Gateway Configuration
APP_GATEWAY_NAME=bidr-app-gateway
BACKEND_POOL_NAME=auth-backend-pool

# Domain Configuration
PRODUCTION_DOMAIN=api.bidr.co.za
SERVICE_PATH=/auth/

# Environment Variables for Production
# IMPORTANT: Keep these keys consistent across local and production environments
PII_ENCRYPTION_KEY=CYr9YsWhL6_TBuREQaJUQF0aHV84sdajft4UtUdPq_o=
SECRET_KEY=apML2mCNBZahA4JEP4zj0CJ7TrO/PgRYA8Z33nYKIT8=
JWT_SECRET_KEY=4DgwpcbHSk+BN8ZZvVh08vpisPNx49LtBSN/CBl0aeA=

# Container Configuration
CPU_CORES=1
MEMORY_GB=1.5
RESTART_POLICY=OnFailure

# Database Configuration (if needed in future)
# DB_HOST=your-db-host
# DB_NAME=your-db-name
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password

# Monitoring Configuration
HEALTH_CHECK_PATH=/health/
LOG_LEVEL=INFO

# Security Configuration
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
DJANGO_SETTINGS_MODULE=authentication_service.settings

# Deployment Notes:
# 1. This service handles user registration, login, and JWT token management
# 2. PII data is encrypted using the PII_ENCRYPTION_KEY
# 3. The service is accessible via https://api.bidr.co.za/auth/
# 4. All environment variables are consistent with local development
# 5. Application Gateway automatically routes /auth/* to this service
