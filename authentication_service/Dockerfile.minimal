FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=authentication_service.settings

# Install minimal system deps
RUN apt-get update && apt-get install -y libpq5 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps from cache
RUN pip install django djangorestframework psycopg2-binary python-decouple gunicorn

# Copy minimal app structure
COPY authentication_service/authentication_service/ authentication_service/
COPY authentication_service/manage.py .

# Create minimal Django setup
RUN python manage.py collectstatic --noinput --settings=authentication_service.settings || true

EXPOSE 8000
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "authentication_service.wsgi:application"]