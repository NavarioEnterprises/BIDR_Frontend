<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Configure static content mime types -->
    <staticContent>
      <remove fileExtension=".png" />
      <mimeMap fileExtension=".png" mimeType="image/png" />
      <remove fileExtension=".jpg" />
      <mimeMap fileExtension=".jpg" mimeType="image/jpeg" />
      <remove fileExtension=".jpeg" />
      <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
      <remove fileExtension=".gif" />
      <mimeMap fileExtension=".gif" mimeType="image/gif" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
    </staticContent>
    
    <!-- Configure response headers -->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type" />
      </customHeaders>
    </httpProtocol>
    
    <!-- Cache control for assets -->
    <caching>
      <profiles>
        <add extension=".png" policy="CacheUntilChange" />
        <add extension=".jpg" policy="CacheUntilChange" />
        <add extension=".jpeg" policy="CacheUntilChange" />
        <add extension=".gif" policy="CacheUntilChange" />
        <add extension=".svg" policy="CacheUntilChange" />
        <add extension=".webp" policy="CacheUntilChange" />
        <add extension=".avif" policy="CacheUntilChange" />
      </profiles>
    </caching>
  </system.webServer>
</configuration>