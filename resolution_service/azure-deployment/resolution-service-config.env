# BIDR Resolution Service - Azure Container Instances Deployment Configuration

# Azure Resource Configuration
RESOURCE_GROUP="bidr-simple-rg"
CONTAINER_REGISTRY="bidrsimpleregistry"
CONTAINER_NAME="bidr-resolution-service"
IMAGE_NAME="bidr-resolution-service"
SERVICE_PORT="8000"
LOCATION="westus"

# Application Gateway Configuration
APP_GATEWAY_NAME="bidr-app-gateway"
BACKEND_POOL_NAME="resolution-backend-pool"

# Domain and SSL Configuration
DOMAIN_NAME="resolution.bidr.co.za"
PRODUCTION_URL="https://resolution.bidr.co.za/"

# Container Environment Variables
SECRET_KEY="your-resolution-service-secret-key-here"
DEBUG="False"
ALLOWED_HOSTS="*"
DJANGO_SETTINGS_MODULE="resolution_service.settings"
CORS_ALLOW_ALL_ORIGINS="True"

# Database Configuration (SQLite for development)
USE_SQLITE="True"
DB_ENGINE="django.db.backends.sqlite3"
DB_NAME="/app/db.sqlite3"

# Resolution Configuration
DISPUTE_AUTO_ASSIGNMENT="True"
ESCALATION_ENABLED="True"
NOTIFICATION_ENABLED="True"
MAX_RESOLUTION_DAYS="30"

# Notification Service Integration
NOTIFICATIONS_SERVICE_URL="https://notifications.bidr.co.za/"
NOTIFICATIONS_ENABLED="True"

# Email Configuration (Optional)
EMAIL_NOTIFICATIONS="True"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"

# Container Resources
CPU_CORES="1.0"
MEMORY_GB="1.5"

# Security and Networking
RESTART_POLICY="OnFailure"
DNS_LABEL="bidr-resolution-service"

# Service Information
SERVICE_NAME_DISPLAY="BIDR Resolution Service"
BIDR_VERSION="v$(date +%s)"
DEPLOYMENT_TIMESTAMP="$(date)"
