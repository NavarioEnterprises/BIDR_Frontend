# BIDR Chat Service - Azure Container Instances Deployment Configuration

# Azure Resource Configuration
RESOURCE_GROUP="bidr-simple-rg"
CONTAINER_REGISTRY="bidrsimpleregistry"
CONTAINER_NAME="bidr-chat-service"
IMAGE_NAME="bidr-chat-service"
SERVICE_PORT="8000"
LOCATION="westus"

# Application Gateway Configuration
APP_GATEWAY_NAME="bidr-app-gateway"
BACKEND_POOL_NAME="chat-backend-pool"

# Domain and SSL Configuration
DOMAIN_NAME="chat-service.bidr.co.za"
PRODUCTION_URL="https://chat-service.bidr.co.za/"

# Container Environment Variables
SECRET_KEY="your-chat-service-secret-key-here"
DEBUG="False"
ALLOWED_HOSTS="*"
DJANGO_SETTINGS_MODULE=chat_service.settings_production
CORS_ALLOW_ALL_ORIGINS="True"

# Chat Configuration
CHAT_ENCRYPTION_KEY="your-chat-encryption-key-here"
WEBSOCKET_ENABLED="True"
MAX_MESSAGE_LENGTH="5000"
MAX_FILE_SIZE_MB="10"

# Notification Configuration
NOTIFICATIONS_SERVICE_URL="https://notifications.bidr.co.za/"
PUSH_NOTIFICATIONS_ENABLED="True"

# Moderation Configuration
ENABLE_CONTENT_MODERATION="True"
AUTO_MODERATION="True"
PROFANITY_FILTER="True"

# Database Configuration
DATABASE_URL=""  # Optional: PostgreSQL URL if not using SQLite
USE_SQLITE="True"

# Redis Configuration (for WebSocket scaling)
REDIS_URL=""  # Optional: Redis URL for WebSocket scaling

# Container Resources
CPU_CORES="1.0"
MEMORY_GB="2.0"

# Security and Networking
RESTART_POLICY="OnFailure"
DNS_LABEL="bidr-chat-service"

# Service Information
SERVICE_NAME_DISPLAY="BIDR Chat Service"
BIDR_VERSION="v$(date +%s)"
DEPLOYMENT_TIMESTAMP="$(date)"
