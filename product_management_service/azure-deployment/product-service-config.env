# BIDR Product Management Service - Azure Deployment Configuration
# This file contains all the configuration variables for the product service deployment

# Azure Configuration
RESOURCE_GROUP=bidr-simple-rg
CONTAINER_REGISTRY=bidrsimpleregistry
CONTAINER_NAME=bidr-product-service
IMAGE_NAME=bidr-product-service
SERVICE_PORT=8000
LOCATION=westus

# Application Gateway Configuration
APP_GATEWAY_NAME=bidr-app-gateway
BACKEND_POOL_NAME=product-backend-pool

# Domain Configuration
PRODUCTION_DOMAIN=products-management.bidr.co.za
SERVICE_PATH=/

# Environment Variables for Production
# IMPORTANT: Keep these keys consistent across environments if needed
SECRET_KEY=your-product-service-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Container Configuration
CPU_CORES=1
MEMORY_GB=1.5
RESTART_POLICY=OnFailure

# Database Configuration (if needed)
# DB_HOST=your-db-host
# DB_NAME=your-db-name
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password

# Monitoring Configuration
HEALTH_CHECK_PATH=/health/
LOG_LEVEL=INFO

# Security Configuration
DJANGO_SETTINGS_MODULE=product_management_service.settings

# Service-specific Configuration
# Add any product-specific environment variables here

# Deployment Notes:
# 1. This service handles product management, catalog, and inventory
# 2. The service is accessible via https://products-management.bidr.co.za/
# 3. Application Gateway automatically routes requests to this service
# 4. Ensure all required environment variables are set before deployment
