# BIDR Reviews Service - Azure Container Instances Deployment Configuration

# Azure Resource Configuration
RESOURCE_GROUP="bidr-simple-rg"
CONTAINER_REGISTRY="bidrsimpleregistry"
CONTAINER_NAME="bidr-reviews-service"
IMAGE_NAME="bidr-reviews-service"
SERVICE_PORT="8000"
LOCATION="westus"

# Application Gateway Configuration
APP_GATEWAY_NAME="bidr-app-gateway"
BACKEND_POOL_NAME="reviews-backend-pool"

# Domain and SSL Configuration
DOMAIN_NAME="reviews.bidr.co.za"
PRODUCTION_URL="https://reviews.bidr.co.za/"

# Container Environment Variables
SECRET_KEY="your-reviews-service-secret-key-here"
DEBUG="False"
ALLOWED_HOSTS="*"
DJANGO_SETTINGS_MODULE="reviews_and_ratings.settings"
CORS_ALLOW_ALL_ORIGINS="True"

# Database Configuration (SQLite for development)
USE_SQLITE="True"
DB_ENGINE="django.db.backends.sqlite3"
DB_NAME="/app/db.sqlite3"

# Content Moderation
CONTENT_MODERATION_ENABLED="True"
AUTO_MODERATION="True"
PROFANITY_FILTER="True"

# Reviews Configuration
MAX_REVIEW_LENGTH="5000"
MIN_REVIEW_LENGTH="10"
RATING_SCALE="5"
ALLOW_ANONYMOUS_REVIEWS="False"

# Container Resources
CPU_CORES="1.0"
MEMORY_GB="1.5"

# Security and Networking
RESTART_POLICY="OnFailure"
DNS_LABEL="bidr-reviews-service"

# Service Information
SERVICE_NAME_DISPLAY="BIDR Reviews Service"
BIDR_VERSION="v$(date +%s)"
DEPLOYMENT_TIMESTAMP="$(date)"
